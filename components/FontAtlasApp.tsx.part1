"use client";

import React, { useState, useEffect, useMemo } from "react";

interface Font {
  family: string;
  category: string;
  variants: string[];
  subsets: string[];
  files: Record<string, string>;
  designer?: string;
  tags?: string[];
  scripts?: string[];
  variable?: boolean;
}

interface Tool {
  name: string;
  icon: string;
  desc: string;
}

type View = "home" | "fonts" | "languages" | "playground" | "tools" | "api" | "pairings" | "favorites";

const CATEGORIES = [
  { name: "Sans Serif", icon: "Aa" },
  { name: "Serif", icon: "Ts" },
  { name: "Display", icon: "Dd" },
  { name: "Handwriting", icon: "Hh" },
  { name: "Monospace", icon: "Mm" },
];

const TOOLS: Tool[] = [
  { name: "Contrast Checker", icon: "WC", desc: "Check text contrast ratios" },
  { name: "Type Scale", icon: "TS", desc: "Generate harmonious type scales" },
  { name: "Unit Converter", icon: "UC", desc: "Convert between px, rem, em" },
  { name: "Spacing Guide", icon: "SG", desc: "Visualize letter & line spacing" },
  { name: "Weight Explorer", icon: "WE", desc: "Explore font weight options" },
  { name: "Fallback Stack", icon: "FS", desc: "Build reliable font stacks" },
  { name: "Subset Checker", icon: "SC", desc: "Check language & character support" },
  { name: "Performance", icon: "PF", desc: "Analyze font loading performance" },
];

const API_ENDPOINTS = [
  { method: "GET", path: "/api/fonts", desc: "List all available fonts" },
  { method: "GET", path: "/api/fonts/:family", desc: "Get font details by family name" },
  { method: "GET", path: "/api/fonts/:family/weights", desc: "Get available weights" },
  { method: "GET", path: "/api/fonts/:family/subsets", desc: "Get available subsets" },
  { method: "GET", path: "/api/fonts/:family/download", desc: "Download font files" },
  { method: "GET", path: "/api/categories", desc: "List all font categories" },
  { method: "GET", path: "/api/scripts", desc: "List all supported scripts/languages" },
  { method: "POST", path: "/api/compare", desc: "Compare multiple fonts" },
];

const SAMPLE_TEXTS: Record<string, string> = {
  "Sans Serif": "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.",
  "Serif": "Typography is the craft of endowing human language with a durable visual form, and thus with an independent existence.",
  "Display": "ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789",
  "Handwriting": "Every child is an artist. The problem is how to remain an artist once we grow up.",
  "Monospace": "const greeting = 'Hello, World!';\nfunction add(a, b) { return a + b; }\nlet x = 42;",
};

function FontCard({
  font,
  isSelected,
  isFavorite,
  isCompared,
  onClick,
  onToggleFavorite,
  onToggleCompare,
}: {
  font: Font;
  isSelected: boolean;
  isFavorite: boolean;
  isCompared: boolean;
  onClick: () => void;
  onToggleFavorite: () => void;
  onToggleCompare: () => void;
}) {
  const weight = font.variants.includes("700") ? "700" : font.variants[0] || "400";

  return (
    <div className={ont-card } onClick={onClick}>
      <div className="font-card-header">
        <span className="font-card-name">{font.family}</span>
        <span className="font-card-designer">{font.designer || "Unknown"}</span>
      </div>
      <div
        className="font-card-specimen"
        style={{ fontFamily: "", sans-serif, fontWeight: parseInt(weight) || 400 }}
      >
        Aa
      </div>
      <div className="font-card-meta">
        <span className="font-card-badge category">{font.category}</span>
        {font.variable && <span className="font-card-badge variable">Variable</span>}
        {isCompared && <span className="font-card-badge active">Compared</span>}
      </div>
      <div className="font-card-fav">
        <button
          className="topbar-btn"
          onClick={(e) => { e.stopPropagation(); onToggleFavorite(); }}
          title="Favorite"
        >
          {isFavorite ? "♥" : "♡"}
        </button>
        <button
          className="compare-btn"
          onClick={(e) => { e.stopPropagation(); onToggleCompare(); }}
          title="Compare"
        >
          +Compare
        </button>
      </div>
    </div>
  );
}

function FontDetail({
  font,
  previewText,
  setPreviewText,
  weight,
  setWeight,
  size,
  setSize,
  spacing,
  setSpacing,
  codeTab,
  setCodeTab,
  isFavorite,
  onToggleFavorite,
  fontTab,
  setFontTab,
}: {
  font: Font;
  previewText: string;
  setPreviewText: (v: string) => void;
  weight: number;
  setWeight: (v: number) => void;
  size: number;
  setSize: (v: number) => void;
  spacing: number;
  setSpacing: (v: number) => void;
  codeTab: string;
  setCodeTab: (v: string) => void;
  isFavorite: boolean;
  onToggleFavorite: () => void;
  fontTab: string;
  setFontTab: (v: string) => void;
}) {
  const [copied, setCopied] = useState(false);
  const previewDisplay = previewText || SAMPLE_TEXTS[font.category] || "The quick brown fox jumps over the lazy dog.";
  const familySlug = font.family.replace(/ /g, "+");
  const familyCamel = font.family.replace(/ /g, "");
  const familyKebab = font.family.replace(/ /g, "-").toLowerCase();
  const serifFamily = font.category === "Serif" ? "serif" : font.category === "Monospace" ? "monospace" : "sans-serif";

  const codes: Record<string, string> = {
    CDN: <link href="https://fonts.googleapis.com/css2?family=:wght@&display=swap" rel="stylesheet" />,
    CSS: ont-family: '', ;\nfont-weight: ;,
    HTML: <link href="https://fonts.googleapis.com/css2?family=&display=swap" rel="stylesheet" />\n<h1 style="font-family: ''"></h1>,
    Tailwind: // tailwind.config.js\nfontFamily: {\n  '': ['', ''],\n},
    "Next.js": // next.config.js or _app.tsx\nimport {  } from 'next/font/google';\nconst Font = ({ subsets: ['latin'] });,
    React: import {  } from '@fontsource/';\nimport '@fontsource//';\n// Then use: style={{ fontFamily: '' }},
  };

  const tabs = ["Preview", "Glyphs", "Languages", "Weights", "Metadata", "License"];

  const handleCopy = () => {
    navigator.clipboard.writeText(codes[codeTab]);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="font-detail open">
      <div className="font-detail-header">
        <h2 className="font-detail-name">{font.family}</h2>
        {font.variable && <span className="font-card-badge variable">Variable</span>}
        <div>
          <a
            href={https://fonts.google.com/specimen/}
            target="_blank"
            rel="noopener noreferrer"
            className="btn btn-primary"
          >
            ↓ Download
          </a>
          <button className="btn btn-outline" onClick={onToggleFavorite}>
            {isFavorite ? "♥ Saved" : "♡ Save"}
          </button>
        </div>
      </div>

      <div className="font-detail-preview">
        <div
          className="font-detail-preview-text"
          style={{
            fontFamily: "", sans-serif,
            fontSize: ${size}px,
            fontWeight: weight,
            letterSpacing: ${spacing}px,
          }}
        >
          {previewDisplay}
        </div>
      </div>

      <div className="font-detail-controls">
        <div className="control-group">
          <input
            className="control-input"
            type="text"
            placeholder="Type your own text..."
            value={previewText}
            onChange={(e) => setPreviewText(e.target.value)}
          />
        </div>
        <div className="control-row">
          <div className="control-group">
            <span className="control-label">Size</span>
            <span className="control-value">{size}px</span>
            <input className="control-slider" type="range" min="12" max="120" value={size} onChange={(e) => setSize(parseInt(e.target.value))} />
          </div>
          <div className="control-group">
            <span className="control-label">Weight</span>
            <span className="control-value">{weight}</span>
            <input className="control-slider" type="range" min="100" max="900" step="100" value={weight} onChange={(e) => setWeight(parseInt(e.target.value))} />
          </div>
          <div className="control-group">
            <span className="control-label">Spacing</span>
            <span className="control-value">{spacing}px</span>
            <input className="control-slider" type="range" min="-5" max="20" value={spacing} onChange={(e) => setSpacing(parseInt(e.target.value))} />
          </div>
        </div>
      </div>

      <div className="code-box">
        <div className="code-tabs">
          {Object.keys(codes).map((tab) => (
            <button key={tab} className={code-tab } onClick={() => setCodeTab(tab)}>
              {tab}
            </button>
          ))}
          <button className="code-copy" onClick={handleCopy}>
            {copied ? "Copied!" : "Copy"}
          </button>
        </div>
        <div className="code-content">
          <pre>{codes[codeTab]}</pre>
        </div>
      </div>

      <div className="code-box">
        <div className="code-tabs">
          {tabs.map((tab) => (
            <button key={tab} className={code-tab } onClick={() => setFontTab(tab)}>
              {tab}
            </button>
          ))}
        </div>
        <div className="code-content">
          {fontTab === "Preview" && (
            <div style={{ fontFamily: "", sans-serif, fontSize: 48, fontWeight: weight, padding: "1rem" }}>
              {previewDisplay}
              <p style={{ fontSize: 24, marginTop: "1rem" }}>
                ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />
                abcdefghijklmnopqrstuvwxyz<br />
                0123456789 !@#$%^&*()
              </p>
            </div>
          )}
          {fontTab === "Glyphs" && (
            <div style={{ fontFamily: "", sans-serif, fontSize: 32, padding: "1rem", display: "flex", flexWrap: "wrap", gap: "0.5rem" }}>
              {Array.from({ length: 94 }, (_, i) => String.fromCharCode(i + 32)).map((char) => (
                <span key={char} style={{ padding: "0.5rem", border: "1px solid #333", borderRadius: 4 }}>{char}</span>
              ))}
            </div>
          )}
          {fontTab === "Languages" && (
            <div style={{ padding: "1rem" }}>
              <p><strong>Supported subsets:</strong></p>
              <div style={{ display: "flex", flexWrap: "wrap", gap: "0.5rem", marginTop: "0.5rem" }}>
                {font.subsets.map((s) => (
                  <span key={s} className="font-card-badge category" style={{ textTransform: "capitalize" }}>{s}</span>
                ))}
              </div>
            </div>
          )}
          {fontTab === "Weights" && (
            <div style={{ padding: "1rem" }}>
              {font.variants.map((v) => (
                <div key={v} style={{ fontFamily: "", sans-serif, fontSize: 24, marginBottom: "0.5rem" }}>
                  <span style={{ color: "#888", marginRight: "1rem", width: 60, display: "inline-block" }}>{v}</span>
                  The quick brown fox jumps over the lazy dog.
                </div>
              ))}
            </div>
          )}
          {fontTab === "Metadata" && (
            <div style={{ padding: "1rem" }}>
              <table style={{ width: "100%" }}>
                <tbody>
                  <tr><td><strong>Family</strong></td><td>{font.family}</td></tr>
                  <tr><td><strong>Category</strong></td><td>{font.category}</td></tr>
                  <tr><td><strong>Designer</strong></td><td>{font.designer || "N/A"}</td></tr>
                  <tr><td><strong>Variants</strong></td><td>{font.variants.length}</td></tr>
                  <tr><td><strong>Subsets</strong></td><td>{font.subsets.length}</td></tr>
                  <tr><td><strong>Variable</strong></td><td>{font.variable ? "Yes" : "No"}</td></tr>
                </tbody>
              </table>
            </div>
          )}
          {fontTab === "License" && (
            <div style={{ padding: "1rem" }}>
              <p>All Google Fonts are released under the <strong>SIL Open Font License v1.1</strong> or the <strong>Apache License, Version 2.0</strong>.</p>
              <p style={{ marginTop: "0.5rem" }}>You can use these fonts for personal and commercial projects, modify them, and distribute them.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function FontPairingsView({ fonts }: { fonts: Font[] }) {
  const [heading, setHeading] = useState(fonts[0]?.family || "");
  const [body, setBody] = useState(fonts[1]?.family || fonts[0]?.family || "");

  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "1.5rem" }}>Font Pairings</h2>
      <div style={{ display: "flex", gap: "1rem", marginBottom: "2rem", flexWrap: "wrap" }}>
        <div className="control-group" style={{ flex: 1, minWidth: 200 }}>
          <span className="control-label">Heading Font</span>
          <select className="control-input" value={heading} onChange={(e) => setHeading(e.target.value)}>
            {fonts.map((f) => (<option key={f.family} value={f.family}>{f.family}</option>))}
          </select>
        </div>
        <div className="control-group" style={{ flex: 1, minWidth: 200 }}>
          <span className="control-label">Body Font</span>
          <select className="control-input" value={body} onChange={(e) => setBody(e.target.value)}>
            {fonts.map((f) => (<option key={f.family} value={f.family}>{f.family}</option>))}
          </select>
        </div>
      </div>
      <div className="hero-card" style={{ padding: "2rem" }}>
        <h3 className="hero-card-text" style={{ fontFamily: "", sans-serif, fontSize: 32, fontWeight: 700, marginBottom: "1rem" }}>
          The Art of Typography
        </h3>
        <p style={{ fontFamily: "", sans-serif, fontSize: 16, lineHeight: 1.6, color: "var(--color-text-secondary)" }}>
          Good typography is invisible. Bad typography is everywhere. The right font pairing
          creates visual hierarchy and improves readability. When heading and body fonts complement
          each other, the design feels cohesive and professional.
        </p>
        <div style={{ fontFamily: "", sans-serif, fontSize: 14, marginTop: "1rem", padding: "1rem", background: "var(--color-bg-secondary)", borderRadius: 8 }}>
          Heading: <strong>{heading}</strong> | Body: <strong>{body}</strong>
        </div>
      </div>
    </div>
  );
}

function FavoritesView({ fonts, favorites, onSelectFont }: { fonts: Font[]; favorites: string[]; onSelectFont: (f: Font) => void }) {
  const favFonts = fonts.filter((f) => favorites.includes(f.family));

  if (favFonts.length === 0) {
    return (
      <div className="layout-main" style={{ textAlign: "center", padding: "4rem 2rem" }}>
        <div style={{ fontSize: 64, marginBottom: "1rem" }}>♡</div>
        <h2 style={{ fontSize: 24, fontWeight: 700, marginBottom: "0.5rem" }}>No Favorites Yet</h2>
        <p style={{ color: "var(--color-text-secondary)" }}>Click the heart icon on any font to add it to your favorites.</p>
      </div>
    );
  }

  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "1.5rem" }}>
        Favorites <span className="font-count">({favFonts.length})</span>
      </h2>
      <div className="font-grid">
        {favFonts.map((font) => (
          <div key={font.family} className="font-card" onClick={() => onSelectFont(font)} style={{ cursor: "pointer" }}>
            <div className="font-card-header">
              <span className="font-card-name">{font.family}</span>
              <span className="font-card-designer">{font.designer || "Unknown"}</span>
            </div>
            <div className="font-card-specimen" style={{ fontFamily: "", sans-serif }}>Aa</div>
            <div className="font-card-meta">
              <span className="font-card-badge category">{font.category}</span>
              {font.variable && <span className="font-card-badge variable">Variable</span>}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function LanguageView({ fonts }: { fonts: Font[] }) {
  const scripts = useMemo(() => {
    const map = new Map<string, number>();
    fonts.forEach((f) => { f.subsets.forEach((s) => { map.set(s, (map.get(s) || 0) + 1); }); });
    return Array.from(map.entries()).sort((a, b) => b[1] - a[1]);
  }, [fonts]);

  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "0.5rem" }}>Language Support</h2>
      <p style={{ color: "var(--color-text-secondary)", marginBottom: "1.5rem" }}>Browse fonts by script and language coverage.</p>
      <div className="font-grid">
        {scripts.map(([scr, count]) => (
          <div key={scr} className="tool-card">
            <div className="tool-card-icon">{scr.slice(0, 2).toUpperCase()}</div>
            <div className="tool-card-title" style={{ textTransform: "capitalize" }}>{scr}</div>
            <div className="tool-card-desc">{count} font{count !== 1 ? "s" : ""}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function PlaygroundView({ fonts }: { fonts: Font[] }) {
  const [selected, setSelected] = useState(fonts[0]?.family || "");
  const [pgText, setPgText] = useState("The quick brown fox jumps over the lazy dog.");
  const [pgSize, setPgSize] = useState(48);

  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "1.5rem" }}>Design Playground</h2>
      <div style={{ display: "flex", gap: "1rem", marginBottom: "2rem", flexWrap: "wrap" }}>
        <div className="control-group" style={{ flex: 1, minWidth: 200 }}>
          <span className="control-label">Font</span>
          <select className="control-input" value={selected} onChange={(e) => setSelected(e.target.value)}>
            {fonts.map((f) => (<option key={f.family} value={f.family}>{f.family}</option>))}
          </select>
        </div>
        <div className="control-group" style={{ flex: 1, minWidth: 200 }}>
          <span className="control-label">Size: {pgSize}px</span>
          <input className="control-slider" type="range" min="12" max="200" value={pgSize} onChange={(e) => setPgSize(parseInt(e.target.value))} />
        </div>
      </div>
      <div className="control-group" style={{ marginBottom: "2rem" }}>
        <input className="control-input" type="text" value={pgText} onChange={(e) => setPgText(e.target.value)} placeholder="Type something..." />
      </div>
      <div className="hero-card" style={{ padding: "3rem", fontFamily: "", sans-serif, fontSize: ${pgSize}px, lineHeight: 1.2, wordBreak: "break-word" }}>
        {pgText}
      </div>
    </div>
  );
}

function ToolsView() {
  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "0.5rem" }}>Font Tools</h2>
      <p style={{ color: "var(--color-text-secondary)", marginBottom: "1.5rem" }}>Essential utilities for working with typography.</p>
      <div className="tools-grid">
        {TOOLS.map((tool) => (
          <div key={tool.name} className="tool-card">
            <div className="tool-card-icon">{tool.icon}</div>
            <div className="tool-card-title">{tool.name}</div>
            <div className="tool-card-desc">{tool.desc}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

function ApiView() {
  const [copiedIdx, setCopiedIdx] = useState<number | null>(null);

  const handleCopy = (idx: number, url: string) => {
    navigator.clipboard.writeText(url);
    setCopiedIdx(idx);
    setTimeout(() => setCopiedIdx(null), 2000);
  };

  return (
    <div className="layout-main">
      <h2 style={{ fontSize: 28, fontWeight: 700, marginBottom: "0.5rem" }}>API & CDN</h2>
      <p style={{ color: "var(--color-text-secondary)", marginBottom: "1.5rem" }}>Access fonts programmatically via our REST API.</p>
      <div className="code-box">
        <div className="code-content">
          <pre>{const BASE_URL = "https://fontatlas.vercel.app";}</pre>
        </div>
      </div>
      <div style={{ marginTop: "1.5rem" }}>
        {API_ENDPOINTS.map((ep, i) => (
          <div
            key={i}
            className="tool-card"
            style={{ display: "flex", alignItems: "center", gap: "1rem", cursor: "pointer", marginBottom: "0.75rem" }}
            onClick={() => handleCopy(i, https://fontatlas.vercel.app)}
          >
            <span className={ont-card-badge } style={{ minWidth: 50, textAlign: "center" }}>
              {ep.method}
            </span>
            <div style={{ flex: 1 }}>
              <div style={{ fontFamily: "monospace", fontSize: 14 }}>https://fontatlas.vercel.app{ep.path}</div>
              <div style={{ color: "var(--color-text-secondary)", fontSize: 13 }}>{ep.desc}</div>
            </div>
            <span style={{ fontSize: 13, color: "var(--color-text-secondary)" }}>{copiedIdx === i ? "Copied!" : "Click to copy"}</span>
          </div>
        ))}
      </div>
    </div>
  );
}
